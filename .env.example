# ============================================================================
# lakehouse-docker-lab · variables de entorno
# Copiar a ".env" y ajustar. "docker compose" lo carga automáticamente.
# ============================================================================

# ---- Modo de ejecución ------------------------------------------------------
# local      -> Spark corre en contenedores Docker (emulando Databricks)
# databricks -> Airflow y dbt apuntan a un workspace real de Azure Databricks
EXECUTION_MODE=local

# ---- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=ventas_cdc
PRODUCER_INTERVAL_SECONDS=1
PRODUCER_MAX_EVENTS=0          # 0 = infinito

# ---- Rutas del data lake compartido ------------------------------------------
LAKEHOUSE_PATH=/opt/data_lakehouse

# ---- Airflow -------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---- dbt -------------------------------------------------------------------
# local | databricks (debe ser coherente con EXECUTION_MODE en general)
DBT_TARGET=local
# Relación (tabla/ruta) que leen los modelos Gold como fuente Silver.
# Local (Spark+Delta por ruta):
DBT_SILVER_RELATION=delta.`/opt/data_lakehouse/silver/ventas`
# Databricks (Unity Catalog / Hive metastore), ejemplo:
# DBT_SILVER_RELATION=main.silver.ventas

# ---- Azure Databricks -----------------------------------------------------
# TODO LO DE ACA ABAJO ES SOLO PARA EL MODO 2 (Databricks real, ver README).
# Si vas a correr todo local (el default), no edites nada de esto — el DAG
# ni dbt lo leen mientras EXECUTION_MODE=local. Los valores de ejemplo de
# abajo son placeholders, no hace falta una cuenta de Databricks para nada.
DATABRICKS_HOST=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
# ^ sin prefijo "https://": dbt-databricks espera solo el hostname
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=gold
# Cluster efímero usado por el DAG en modo databricks (DatabricksSubmitRunOperator)
DATABRICKS_SPARK_VERSION=15.4.x-scala2.12
DATABRICKS_NODE_TYPE=Standard_DS3_v2
DATABRICKS_NUM_WORKERS=1
# Conexión de Airflow hacia Databricks (formato URI). Ejemplo:
# AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://:dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
AIRFLOW_CONN_DATABRICKS_DEFAULT=
